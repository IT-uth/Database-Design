  <diagram name="Phân tích" id="analysis-page">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="analysis-text" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;align=left;verticalAlign=top;" value="&#xa;&lt;h1 style=&quot;margin-top:0&quot;&gt;Bài 1.1 — Hệ thống thông tin quản lý sinh viên&lt;/h1&gt;&#xa;&lt;div&gt;&lt;b&gt;Thực thể chính:&lt;/b&gt;&lt;/div&gt;&#xa;&lt;div&gt;1. Sinh viên&lt;/div&gt;&#xa;&lt;div&gt;2. Khóa học&lt;/div&gt;&#xa;&lt;div&gt;3. Giảng viên&lt;/div&gt;&#xa;&lt;div&gt;4. Lớp học phần&lt;/div&gt;&#xa;&lt;div&gt;5. Kết quả học tập&lt;/div&gt;&#xa;&lt;br&gt;&#xa;&lt;div&gt;&lt;b&gt;Quan hệ:&lt;/b&gt;&lt;/div&gt;&#xa;&lt;div&gt;• Sinh viên — Kết quả học tập: 1:N&lt;/div&gt;&#xa;&lt;div&gt;• Lớp học phần — Kết quả học tập: 1:N&lt;/div&gt;&#xa;&lt;div&gt;• Sinh viên — Lớp học phần: M:N, được giải quyết qua Kết quả học tập&lt;/div&gt;&#xa;&lt;div&gt;• Khóa học — Lớp học phần: 1:N&lt;/div&gt;&#xa;&lt;div&gt;• Giảng viên — Lớp học phần: 1:N&lt;/div&gt;&#xa;&lt;div&gt;• Khóa học — Giảng viên: M:N&lt;/div&gt;&#xa;&lt;br&gt;&#xa;&lt;div&gt;&lt;b&gt;Khóa chính:&lt;/b&gt;&lt;/div&gt;&#xa;&lt;div&gt;• Sinh viên: Mã sinh viên&lt;/div&gt;&#xa;&lt;div&gt;• Khóa học: Mã khóa học&lt;/div&gt;&#xa;&lt;div&gt;• Giảng viên: Mã giảng viên&lt;/div&gt;&#xa;&lt;div&gt;• Lớp học phần: Mã lớp&lt;/div&gt;&#xa;&lt;div&gt;• Kết quả học tập: (Mã sinh viên, Mã lớp học phần)&lt;/div&gt;&#xa;" vertex="1">
          <mxGeometry x="80" y="80" width="690" height="700" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
